DB_OPERATOR_STATE_TABLE="foxtrot-db-operator"
DB_OPERATOR_STATE_NAMESPACE="appdb"
AWS_DEFAULT_REGION="ap-northeast-2"
# 로컬에서만 DB_OPERATOR_DYNAMODB_ENDPOINT를 설정합니다.
DB_OPERATOR_API_TOKEN="REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS"
DB_OPERATOR_REGISTRY="/etc/foxtrot/registry.json"
DB_OPERATOR_RETENTION_SECONDS=3600
DB_OPERATOR_OBSERVATION_CACHE_SECONDS=2
SOURCE_ADMIN_DSN="postgresql://operator:REPLACE@source.internal/appdb?sslmode=verify-full"
TARGET_ADMIN_DSN="postgresql://operator:REPLACE@target.internal/appdb?sslmode=verify-full"
SOURCE_REPLICATION_DSN="postgresql://replicator:REPLACE@source.internal/appdb?sslmode=verify-full"
TARGET_REPLICATION_DSN="postgresql://replicator:REPLACE@target.internal/appdb?sslmode=verify-full"
PGBOUNCER_ADMIN_DSN="postgresql://pooler_admin:REPLACE@127.0.0.1:6432/pgbouncer?sslmode=verify-full"
PGBOUNCER_PROBE_DSN="postgresql://app_writer:REPLACE@127.0.0.1:6432/appdb?sslmode=verify-full"
